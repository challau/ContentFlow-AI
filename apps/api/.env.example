# Copy to .env and fill in. Values shown are development defaults.

NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug
SWAGGER_ENABLED=true

# --- Data ------------------------------------------------------------------
DATABASE_URL=postgresql://USER@localhost:5432/contentflow?schema=public
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# --- Auth (generate with: openssl rand -hex 32) -----------------------------
JWT_ACCESS_SECRET=replace-me-with-32-random-bytes-hex
JWT_REFRESH_SECRET=replace-me-with-a-different-32-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# --- OAuth (optional; endpoints return 501 until both values are set) -------
OAUTH_CALLBACK_BASE=http://localhost:4000
WEB_APP_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- AI layer ---------------------------------------------------------------
# anthropic | openai | gemini | local
# "local" is a deterministic offline provider: the full pipeline runs, is
# schema-valid and is reproducible, with no API key and no network calls.
LLM_PROVIDER=local
LLM_MODEL=claude-opus-5
LLM_MAX_TOKENS=16384
LLM_TEMPERATURE=0.7
LLM_MAX_RETRIES=3
LLM_TIMEOUT_MS=180000

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Execution --------------------------------------------------------------
PIPELINE_CONCURRENCY=4
AGENT_CONCURRENCY=4
RUN_COST_CREDITS=50
# Set to false on API pods when workers run separately.
# WORKER_ENABLED=true

# --- Storage ----------------------------------------------------------------
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
S3_REGION=us-east-1
S3_BUCKET=contentflow-media
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Rate limiting ----------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=120
